# Copy to .env and fill in. Never commit .env.
# Any setting in mentora/config/defaults.yaml can be overridden with MENTORA_<SECTION>__<KEY>.

MENTORA_DATABASE_URL=postgresql+psycopg://mentora:mentora@localhost:5432/mentora
MENTORA_REDIS_URL=redis://localhost:6379/0

# LLM back-end: auto (Claude if a key below is set, else offline templates) | offline | hosted | local
MENTORA_LLM__BACKEND=auto
# Claude API key (from console.anthropic.com). Setting it is all you need for real tutor replies.
ANTHROPIC_API_KEY=
MENTORA_LOCAL_LLM_BASE_URL=http://localhost:11434/v1
# Only behind scripts/ollama_gateway.py (remote Ollama through a tunnel)
MENTORA_LOCAL_LLM_API_KEY=

# Web sessions. Set a long random secret in production and turn dev login off.
MENTORA_SESSION_SECRET=change-me
MENTORA_DEV_LOGIN=true
# Public demos without Moodle: when set, dev sign-in as a teacher needs this code.
MENTORA_DEV_TEACHER_CODE=
MENTORA_PUBLIC_BASE_URL=http://localhost:8000

# LTI 1.3 platform registration (values from Moodle: Site admin > Plugins > External tool)
MENTORA_LTI_ISSUER=
MENTORA_LTI_CLIENT_ID=
MENTORA_LTI_DEPLOYMENT_IDS=["1"]
MENTORA_LTI_AUTH_LOGIN_URL=
MENTORA_LTI_KEY_SET_URL=
# Inside a Moodle iframe, browsers need: MENTORA_COOKIE_SAMESITE=none and MENTORA_COOKIE_HTTPS_ONLY=true

# Pseudonymisation salt for learner IDs
MENTORA_PSEUDONYM_SALT=change-me
